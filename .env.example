# ---------------------------------------------------------------------------
# Project NEXT — CRME
#
# EVERY VARIABLE HERE IS OPTIONAL. With no .env file at all the engine runs
# entirely on its deterministic reasoning path: real vector math, real refusal
# gates, real decision records, no network calls, no credentials.
#
# Adding a key layers hosted-model judgement on top of the deterministic
# scores. It never replaces them, and a failed or slow call silently falls
# back — a governance gate that stops working when a key expires is not a
# governance gate.
# ---------------------------------------------------------------------------

# --- Option A: Claude (preferred) ------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# CRME_CLAUDE_MODEL=claude-opus-5

# --- Option B: Gemini, the platform named in the architecture ---------------
# GOOGLE_API_KEY=...
# CRME_GEMINI_MODEL=gemini-2.5-pro

# --- Force the deterministic path even when a key is present ---------------
# Useful for reproducible demos and for benchmarking cycle time without
# network latency in the measurement.
# CRME_DISABLE_MODEL=1
